<mxfile host="drawio"><diagram id="ztims-conceptual-framework" name="Conceptual Framework"><mxGraphModel dx="1280" dy="560" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="20" y="20.0" width="230" height="520" as="geometry"/></mxCell><mxCell id="c2" value="INPUT" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=24;verticalAlign=middle;align=center;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20.0" width="230" height="38.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="296" y="20.0" width="650" height="520" as="geometry"/></mxCell><mxCell id="c4" value="PROCESS" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=24;verticalAlign=middle;align=center;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="296" y="20.0" width="650" height="38.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="992" y="20.0" width="270" height="520" as="geometry"/></mxCell><mxCell id="c6" value="OUTPUT" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=24;verticalAlign=middle;align=center;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="992" y="20.0" width="270" height="38.0" as="geometry"/></mxCell><mxCell id="c7" value="&lt;div style=&quot;text-align:justify;margin-bottom:22px&quot;&gt;Current tourism information management practices of the Municipal Tourism Office&lt;/div&gt;&lt;div style=&quot;text-align:justify;margin-bottom:22px&quot;&gt;Operational issues under the current decentralized process&lt;/div&gt;&lt;div style=&quot;text-align:justify;margin-bottom:22px&quot;&gt;Identified functional and non-functional requirements gathered from tourists, Tourism Officers, and Enterprise Managers&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;verticalAlign=top;spacing=0;fontSize=20;fontFamily=Times New Roman;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="38" y="72.0" width="196" height="454" as="geometry"/></mxCell><mxCell id="c8" value="&lt;div style=&quot;margin-bottom:22px&quot;&gt;Requirements analysis&lt;/div&gt;&lt;div style=&quot;margin-bottom:22px&quot;&gt;Design, development, and implementation of ZTIMS using the Agile methodology&lt;/div&gt;&lt;div style=&quot;margin-left:12px;margin-bottom:22px;margin-top:10px&quot;&gt;Theoretical Foundation&lt;/div&gt;&lt;div style=&quot;margin-left:12px;margin-bottom:4px&quot;&gt;Destination Management and Marketing Framework (Buhalis, 2000)&lt;/div&gt;&lt;div style=&quot;margin-left:12px;margin-bottom:4px&quot;&gt;Destination Information and Knowledge Management (Sheehan et al., 2016)&lt;/div&gt;&lt;div style=&quot;margin-left:12px;margin-bottom:4px&quot;&gt;Stakeholder Participation (d&#x27;Angella &amp;amp; Go, 2009; Sautter &amp;amp; Leisen, 1999)&lt;/div&gt;&lt;div style=&quot;margin-left:12px;margin-bottom:22px;margin-top:34px&quot;&gt;Evaluation&lt;/div&gt;&lt;div style=&quot;margin-left:12px;margin-bottom:4px&quot;&gt;User acceptance evaluation using the Technology Acceptance Model (TAM) (Davis, 1989)&lt;/div&gt;&lt;div style=&quot;margin-left:12px;margin-bottom:4px&quot;&gt;Software product quality evaluation using ISO/IEC 25010:2023&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;verticalAlign=top;spacing=0;fontSize=20;fontFamily=Times New Roman;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="316" y="72.0" width="620" height="454" as="geometry"/></mxCell><mxCell id="c9" value="DEVELOPED AND EVALUATED WEB-BASED ZAMBOANGUITA TOURISM INFORMATION MANAGEMENT SYSTEM (ZTIMS) FOR THE MUNICIPALITY OF ZAMBOANGUITA" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;fontSize=20;fontStyle=1;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1010" y="78.0" width="234" height="442" as="geometry"/></mxCell><mxCell id="c10" style="endArrow=block;endFill=1;endSize=4;html=1;strokeColor=#000000;strokeWidth=8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="252" y="299" as="sourcePoint"/><mxPoint x="294" y="299" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" style="endArrow=block;endFill=1;endSize=4;html=1;strokeColor=#000000;strokeWidth=8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="948" y="299" as="sourcePoint"/><mxPoint x="990" y="299" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
