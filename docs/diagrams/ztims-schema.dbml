Table attraction_periods {
  spot_id text
  year integer
  month integer
  state text [not null]
  current_version_id text [not null]
  finalized_version_id text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (spot_id, year, month) [pk]
  }
}

Table attraction_report_versions {
  id text [pk, default: `ztims_new_id()`]
  spot_id text [not null]
  year integer [not null]
  month integer [not null]
  version integer [not null]
  dates_counted integer [not null]
  zero_days integer [not null, default: `0`]
  closed_days integer [not null, default: `0`]
  total integer [not null]
  res_zamboanguita integer [not null, default: `0`]
  res_negros_oriental integer [not null, default: `0`]
  res_other_province integer [not null, default: `0`]
  res_foreign integer [not null, default: `0`]
  res_unrecorded integer [not null, default: `0`]
  male integer [not null, default: `0`]
  female integer [not null, default: `0`]
  sex_unrecorded integer [not null, default: `0`]
  daily jsonb [not null]
  source_digest text [not null, default: '']
  reason text [not null, default: '']
  submitted_by_role text [not null, default: '']
  submitted_by_email text [not null, default: '']
  submitted_at timestamptz [not null, default: `now()`]
  indexes {
    (spot_id, year, month, version) [unique]
  }
}

Table attraction_settings {
  spot_id text [pk]
  reporting_from date [not null]
  attraction_code text [not null, default: '']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table rate_limits {
  key text [pk]
  hits integer [not null]
  expires_at timestamptz [not null]
}

