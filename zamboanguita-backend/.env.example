NODE_ENV=development
MONGO_URI=mongodb+srv://DATABASE_USER:DATABASE_PASSWORD@CLUSTER_HOST/zamboanguita?retryWrites=true&w=majority
PORT=5000

# Every origin the browser is allowed to call this API from, comma-separated.
# This MUST include the deployed frontend's address or the browser blocks every
# request from it — login, registration, spots, all of it. Include the scheme and
# no trailing slash. Vercel preview URLs (*.vercel.app) are accepted automatically.
# Production example: CORS_ORIGIN=https://ztims.vercel.app
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

JWT_SECRET=generate-a-long-random-value-and-never-commit-it

INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=use-a-strong-one-time-bootstrap-password

# Where password-reset links point. Falls back to the first CORS_ORIGIN entry.
# Reset is for staff accounts: Tourism Officers and Tourist Establishment Managers.
# Visitors browse ZTIMS without an account, so they have nothing to reset.
PUBLIC_SITE_URL=https://ztims.vercel.app

# Gmail address and App Password (not the account password) used to send password
# reset emails. Leave unset to disable password reset with a clear message.
MAIL_USER=
MAIL_PASSWORD=

# Routing key for travel directions, from openrouteservice.org (free account,
# 2,000 requests a day). It stays here on the server and is never sent to the
# browser. With it set, visitors can route by Car, Bicycle and Walking, and
# address search uses OpenRouteService's geocoder.
#
# Leave it blank and ZTIMS falls back to the public OSRM demo server, which only
# runs the car profile — so only Car is offered, because a mode nothing can
# calculate must never be shown. Address search then uses OpenStreetMap's
# Nominatim. Both are free and keyless, but neither is meant for heavy traffic,
# so set this before a live demo.
ORS_API_KEY=

# Photo uploads. Photos go from the browser straight to Cloudinary — they are far
# too large to pass through this API, which accepts 1 MB bodies.
#
# With these set, the browser must first ask ZTIMS for a signature, and only a
# signed-in Tourism Officer or establishment manager can get one. The secret
# stays here on the server and is never sent to the browser.
#
# Leave them unset and the old unsigned upload preset is used instead, which
# works but lets anyone who reads the page source upload to the account. Set
# them, then switch the preset to "signed" in the Cloudinary console.
#
# Cloud name, API key and API secret: Cloudinary dashboard, top of the page.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Where uploads are filed in the Cloudinary account. Optional.
CLOUDINARY_FOLDER=ztims
